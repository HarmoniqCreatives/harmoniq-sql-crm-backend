# Use 5001 locally so this API does not collide with the legacy Faloniq CRM on 5000.
PORT=5001
NODE_ENV=development

# Native MySQL 8 (no Docker). DATABASE_URL is optional documentation alias only.
# DATABASE_URL=mysql://harmoniq:change-me@127.0.0.1:3306/harmoniq_creative_crm
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=harmoniq_creative_crm
DB_USER=harmoniq
DB_PASSWORD=change-me
DB_LOGGING=0

# Public frontend origin (CORS). Prefer APP_BASE_URL for invite/verify links in production.
FRONTEND_URL=http://localhost:5174
# Production on Render (required). https, no trailing slash, never localhost.
APP_BASE_URL=

# JWT auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Exact proxy hop count behind Render/Vercel/nginx (never set to true)
TRUST_PROXY_HOPS=1

# Mail: MAIL_DRIVER=memory for local/tests. Production: MAIL_PROVIDER=resend (HTTPS).
MAIL_DRIVER=memory
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=Harmoniq Creative <noreply@example.com>
# SMTP for local development only (Render blocks outbound 25/465/587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Assignment emails (new lead + transfer). Set to 0 to disable without removing hooks.
# Default when unset: enabled (1).
LEAD_ASSIGNMENT_EMAIL_ENABLED=1

# Automatic Email Reports worker. Set to 0 to disable the in-process scheduler.
EMAIL_REPORTS_ENABLED=1
# Optional poll interval (ms, min 5000). Default 60000.
EMAIL_REPORTS_POLL_MS=60000
# Optional force timezone for all companies (Asia/Dubai|Asia/Kolkata|Asia/Karachi).
# When unset, each company's timezone is used.
EMAIL_REPORTS_TIMEZONE=

# Meta Lead Ads / Facebook Login (required for Meta Integration Phase 1+)
# Generate encryption key: openssl rand -hex 32
META_TOKEN_ENCRYPTION_KEY=
# Optional key version integer for ciphertext rotation (default 1)
META_TOKEN_ENCRYPTION_KEY_VERSION=1
# OAuth callback URL registered in the Meta app (API host + path)
META_REDIRECT_URI=http://localhost:5001/api/meta/oauth/callback
# Webhook verify token you configure in Meta Developer Console
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version (Lead Ads)
META_GRAPH_API_VERSION=v21.0
# Central-mode App credentials (only when using a shared Meta app via env, not a customer profile)
META_APP_ID=
META_APP_SECRET=

# WhatsApp Cloud API — Manual configuration is the primary connection path in the UI.
# Platform Meta app credentials stay server-side for Graph calls / webhooks (not Embedded Signup).
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# Public WhatsApp Cloud API webhook verify token (Meta App Dashboard → WhatsApp → Configuration)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Graph API version for WhatsApp Cloud API (docs: v27.0)
WHATSAPP_GRAPH_API_VERSION=v27.0
# Embedded Signup remains available via API but is not used by the Integrations UI.
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=0
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Manual Cloud API config is allowed in development/test by default.
# In production, set WHATSAPP_MANUAL_TOKEN_ENABLED=1 only when intentionally enabling manual tokens.
WHATSAPP_MANUAL_TOKEN_ENABLED=0
# Outbox worker (P3). Set WHATSAPP_OUTBOX_AUTORUN=0 to disable the in-process sender.
WHATSAPP_OUTBOX_AUTORUN=1
WHATSAPP_OUTBOX_POLL_MS=3000
WHATSAPP_OUTBOX_LEASE_MS=60000
WHATSAPP_OUTBOX_BATCH_SIZE=10
WHATSAPP_OUTBOX_MAX_ATTEMPTS=5
WHATSAPP_GRAPH_TIMEOUT_MS=20000
