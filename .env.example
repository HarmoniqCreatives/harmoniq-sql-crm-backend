# =============================================================================
# Harmoniq Creative CRM — backend environment template
# Copy to .env and replace placeholders. Never commit real secrets.
# Groups mirror backend config modules.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVER
# -----------------------------------------------------------------------------
PORT=5001
NODE_ENV=development
TRUST_PROXY_HOPS=1

# -----------------------------------------------------------------------------
# 2. DATABASE (Sequelize / MySQL)
# DB_ENV is mandatory: local | production
# local      → NODE_ENV=development|test  → DB_NAME=harmoniq_creative_crm_local
# production → NODE_ENV=production        → DB_NAME=harmoniq_creative_crm_live
# Never fall back to another database name.
# -----------------------------------------------------------------------------
DB_ENV=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=harmoniq_creative_crm_local
DB_USER=harmoniq
DB_PASSWORD=change-me
DB_LOGGING=0

# Production example (separate host/secrets — do not mix with local):
# NODE_ENV=production
# DB_ENV=production
# DB_NAME=harmoniq_creative_crm_live
# DB_HOST=your-production-host
# DB_USER=your-production-user
# DB_PASSWORD=your-production-password

# -----------------------------------------------------------------------------
# 3. FRONTEND / PUBLIC URLS
# FRONTEND_URL = SPA origin (CORS)
# APP_BASE_URL = absolute links in emails/invites (required in production; https, no trailing slash)
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5174
APP_BASE_URL=

# -----------------------------------------------------------------------------
# 4. JWT / AUTH
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
# Note: refresh session length is currently driven by code (7 days); this value is informational.
JWT_REFRESH_TTL=7d
PASSWORD_RESET_HOURS=1

# -----------------------------------------------------------------------------
# 5. EMAIL / SMTP
# Local/tests: MAIL_DRIVER=memory
# Local SMTP: MAIL_DRIVER=smtp + SMTP_* 
# Production: prefer MAIL_PROVIDER=resend + RESEND_API_KEY (HTTPS)
# -----------------------------------------------------------------------------
MAIL_DRIVER=memory
MAIL_PROVIDER=
RESEND_API_KEY=
# Preferred sender (display name defaults to Melo when MAIL_FROM_NAME is unset).
MAIL_FROM_EMAIL=erp.accounts@suvidretail.in
MAIL_FROM_NAME=Melo
# Legacy combined From header (email is kept; display name is forced to Melo / MAIL_FROM_NAME).
MAIL_FROM=Melo <erp.accounts@suvidretail.in>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# 6. LEAD ASSIGNMENT + EMAIL REPORTS
# -----------------------------------------------------------------------------
LEAD_ASSIGNMENT_EMAIL_ENABLED=1
EMAIL_REPORTS_ENABLED=1
EMAIL_REPORTS_POLL_MS=60000
# Optional force timezone: Asia/Dubai | Asia/Kolkata | Asia/Karachi
EMAIL_REPORTS_TIMEZONE=

# -----------------------------------------------------------------------------
# 7. META / FACEBOOK LEAD ADS
# Generate encryption key: openssl rand -hex 32
# Prefer META_GRAPH_API_VERSION (META_GRAPH_VERSION is a deprecated alias).
# -----------------------------------------------------------------------------
META_TOKEN_ENCRYPTION_KEY=
META_TOKEN_ENCRYPTION_KEY_VERSION=1
META_REDIRECT_URI=http://localhost:5001/api/meta/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
# META_GRAPH_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
# META_SYNC_AUTORUN: in-process workers for webhook ingestions + queued sync jobs (1/0).
# Independent of periodic Auto Sync below.
META_SYNC_AUTORUN=1
# META_AUTO_SYNC_*: periodic Graph page lead sync schedule (env-only; restart to apply).
# false disables only the periodic scheduler — webhooks and Manual Sync Now still work.
META_AUTO_SYNC_ENABLED=true
# Allowed values: 10 or 15. Default when unset: 10.
META_AUTO_SYNC_INTERVAL_MINUTES=10

# -----------------------------------------------------------------------------
# 8. WHATSAPP CLOUD API
# -----------------------------------------------------------------------------
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v27.0
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=0
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_MANUAL_TOKEN_ENABLED=0
WHATSAPP_OUTBOX_AUTORUN=1
WHATSAPP_OUTBOX_POLL_MS=3000
WHATSAPP_OUTBOX_LEASE_MS=60000
WHATSAPP_OUTBOX_BATCH_SIZE=10
WHATSAPP_OUTBOX_MAX_ATTEMPTS=5
WHATSAPP_GRAPH_TIMEOUT_MS=20000
WHATSAPP_TEMPLATE_PAGE_LIMIT=50

# -----------------------------------------------------------------------------
# 9. MIGRATION GATES (leave unset unless explicitly approved)
# -----------------------------------------------------------------------------
# MIGRATION_ALLOW_LIVE_MONGO=0
# MIGRATION_ALLOW_LIVE_SQL_IMPORT=0
# MIGRATION_IMPORT_APPROVED=0

# -----------------------------------------------------------------------------
# 10. TEST-ONLY (optional)
# -----------------------------------------------------------------------------
# RATE_LIMIT_TEST=1
